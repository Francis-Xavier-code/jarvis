# JARVIS local config — COPY THIS to config.toml and fill in your key.
# config.toml is gitignored (NEVER commit it — it holds secrets).
#
# All keys are read by plugins at startup (config-core loads this file first,
# then provider-openai / channels read the values they need).
#
# Anything under [section] is a nested dict: e.g. [provider-openai] below is
# read by provider-openai as config.get("provider-openai", {}).

# ---- assistant safety gate ----
# Every assistant-initiated action (bash commands, file writes outside the
# project root, plugin installs) asks for y/N confirmation by default.
# Set auto_approve = true to approve them automatically — for trusted,
# headless setups where nobody is at the keyboard to answer prompts.
# Toggling this hot-reloads into effect without a restart; in the TUI you can
# also flip it live with: /autoapprove [on|off|toggle]
auto_approve = false

# ---- model provider (OpenAI-compatible) ----
[provider-openai]
openai_base_url = "https://opencode.ai/zen/go/v1"
openai_api_key = "sk-REPLACE-ME"          # the only secret — keep out of git
model = "deepseek-v4-flash"                # cheap + fast; aggregator has no gemini

# ---- Home Assistant (optional; only needed for hass.* tools) ----
[homeassistant]
ha_base_url = "http://192.168.1.100:8123"
ha_token = "REPLACE-ME"

# ---- LLM response cache (cache-core) - saves tokens by replaying hits ----
[cache]
enabled = true        # set false to bypass entirely
ttl_seconds = 300     # entry lifetime in seconds
max_entries = 64      # LRU cap

# ---- memory: conversation budget sent to the provider ----
[memory]
max_rounds = 30       # keep the last N user rounds in the request (full history still persisted)

# ---- agent loop: tool-call budget ----
[agent]
max_tool_rounds = 4   # tool-call rounds per turn; after this the kernel runs one
                      # wind-down request so multi-step tasks still get their final
                      # answer, then reports the limit if the model keeps calling tools

# ---- personality: the assistant's persona (injected into every turn) ----
[personality]
name = "JARVIS"
style = "简洁、温暖、带点俏皮;emoji 克制使用"
traits = "乐于助人、精确、诚实面对局限"
rules = "绝不说自己没做过的事;需要工具或插件时直接说明"

# ---- web search (web-tools plugin) ----
[web]
# GET endpoint returning HTML with result links/snippets (default DuckDuckGo)
search_url = "https://html.duckduckgo.com/html/"

# ---- agent identity: who signs JARVIS's edits ----
# Deliberately ISOLATED from the host git config: JARVIS never reads
# ~/.gitconfig, so the host user's real email is never leaked into files.
# For git commits, use: git -c user.name=<name> -c user.email=<email> commit ...
[agent-identity]
name = "JARVIS"
email = "jarvis@jarvis.local"
sign_edits = true      # set false to stop appending signatures
